# macOS / editors
.DS_Store
*.swp

# secrets and local config (never commit)
.env
.env.*
*.plist
google-services.json
service_account*.json
*secret*
*.pem
*.key
.claude/

# Vercel (link + local env created by `vercel link`)
.vercel/
.env.local

# dependencies and generated output
node_modules/
# generated by v2/_tools/make-deploy.py
v2/_deploy/
# QA screenshots and reports (about 500 MB), regenerate with the QA scripts
v2/_qa/
# local rollback archives
v2/_backup/*.zip
# reference screenshots of the original templates
v2/_specs/a/
v2/_specs/b/
v2/_specs/c/
